# Optional local overrides; copy to ignored .dev.vars only if needed.
# Local development stays cloud-disabled. Production uses wrangler.deploy.jsonc.
CLOUD_EXECUTION_APPROVED=false
AI_GATEWAY_ID=YOUR_AI_GATEWAY_ID
AI_GATEWAY_BYOK_ALIAS=YOUR_AI_GATEWAY_BYOK_ALIAS
# The OpenAI provider key belongs in Cloudflare AI Gateway BYOK / Secrets Store.
# The Worker authenticates through its AI binding; no OpenAI API key or
# Cloudflare API token belongs in this file, the native app, or source control.
