// Portable template: copy to ignored wrangler.deploy.jsonc and fill in your values.
// Namespace 0 is a local-only placeholder; choose a unique positive integer for deployment.
// Default local development stays cloud-disabled. See README.md for setup.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "your-worker-name",
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "browser": {
    "binding": "BROWSER"
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "your-r2-bucket-name"
    }
  ],
  "ratelimits": [
    {
      "name": "RESOLVE_RATE_LIMITER",
      "namespace_id": "0",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "CLOUD_EXECUTION_APPROVED": "false",
    "AI_GATEWAY_ID": "YOUR_AI_GATEWAY_ID",
    "AI_GATEWAY_BYOK_ALIAS": "YOUR_AI_GATEWAY_BYOK_ALIAS"
  },
  "env": {
    "production": {
      "name": "your-worker-name",
      "browser": {
        "binding": "BROWSER"
      },
      "r2_buckets": [
        {
          "binding": "ARTIFACTS",
          "bucket_name": "your-r2-bucket-name"
        }
      ],
      "ratelimits": [
        {
          "name": "RESOLVE_RATE_LIMITER",
          "namespace_id": "0",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "vars": {
        "CLOUD_EXECUTION_APPROVED": "true",
        "AI_GATEWAY_ID": "YOUR_AI_GATEWAY_ID",
        "AI_GATEWAY_BYOK_ALIAS": "YOUR_AI_GATEWAY_BYOK_ALIAS"
      }
    }
  }
}
