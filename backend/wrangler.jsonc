// Cloud resources and bounded live verification approved by Pete on September 8, 2026.
// Default local development remains cloud-disabled; deploy with --env production.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "astrabrowse-backend",
  "account_id": "7ab7b97c380400e3bccc5d148fe81474",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "browser": {
    "binding": "BROWSER"
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "astrabrowse-artifacts"
    }
  ],
  "ratelimits": [
    {
      "name": "RESOLVE_RATE_LIMITER",
      "namespace_id": "2026090801",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "CLOUD_EXECUTION_APPROVED": "false",
    "AI_GATEWAY_ID": "astrabrowse-demo-gateway",
    "AI_GATEWAY_BYOK_ALIAS": "openai-astrabrowse-demo"
  },
  "env": {
    "production": {
      "name": "astrabrowse-backend",
      "browser": {
        "binding": "BROWSER"
      },
      "r2_buckets": [
        {
          "binding": "ARTIFACTS",
          "bucket_name": "astrabrowse-artifacts"
        }
      ],
      "ratelimits": [
        {
          "name": "RESOLVE_RATE_LIMITER",
          "namespace_id": "2026090801",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "vars": {
        "CLOUD_EXECUTION_APPROVED": "true",
        "AI_GATEWAY_ID": "astrabrowse-demo-gateway",
        "AI_GATEWAY_BYOK_ALIAS": "openai-astrabrowse-demo"
      }
    }
  }
}
