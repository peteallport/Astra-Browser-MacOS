{
  "name": "astrabrowse-backend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts src/translation/*.test.ts",
    "dev:fixture": "node --experimental-strip-types scripts/local-fixture.ts",
    "deploy:dry-run": "wrangler deploy --env production --dry-run --outdir dist",
    "deploy": "wrangler deploy --env production"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "wrangler": "4.129.0"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0",
    "linkedom": "0.18.13"
  }
}
